# Dependencies + build outputs
node_modules
dist
dist-electron
dist-renderer
release
.release-dist.lock
.vite

# Stale build stragglers at the project root (pre-v0.7.x layout when the
# renderer dropped index.html + hashed CSS/JS into the repo root by mistake).
# Real renderer entry lives at renderer/index.html.
/index.html
/index-*.css
/index-*.js

# Bundled web viewer source. `webclient/index.html` is committed input for
# `npm run webclient:bundle`; main/webclientHtml.js is the generated embedded
# copy shipped by the server and must not be edited by hand.

# User-facing data folder (catalog DB + assets) lives at <dataDir> per
# AGENTS.md §8. This entry catches the legacy `data/` runtime path.
data

# Logs, secrets, OS junk
*.log
.DS_Store
.env
.env.local

# Generated by the test lanes (testctl's TMPDIR is .cache/tmp; the Python
# retention test leaves __pycache__ behind), so a passing receipt keys a clean tree.
.cache
__pycache__

# Local Claude Code settings (per-Mac config; shared rules go in AGENTS.md
# at the repo root). Keep the .claude/ directory itself trackable so we
# can commit non-local settings later without un-ignoring the whole tree.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# graphify knowledge-graph output (regenerate with the graphify skill)
graphify-out

# Owner deletion convention (2026-09-22): recoverable "deletes" are moved into
# _trash/ rather than removed. It is deliberately outside Git — see
# _trash/README.md and the "Working rules" section in AGENTS.md.
_trash/
/_trash
