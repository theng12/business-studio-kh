{
  "name": "media-studio-kh",
  "private": true,
  "version": "0.1.32",
  "description": "Business Studio KH — product images, labels, and catalogs in one workspace",
  "author": "TerraNash",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "cross-env ELECTRON_ENABLE_LOGGING=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "icon:build": "node scripts/build-icon.js",
    "webclient:bundle": "node scripts/build-webclient.js",
    "predist": "npm run webclient:bundle && npm run install:sharp",
    "dist": "vite build && electron-builder",
    "postdist": "npm run native:host",
    "dist:arm64": "vite build && electron-builder --mac dmg:arm64",
    "release": "npm version patch --no-git-tag-version && npm run dist",
    "release:minor": "npm version minor --no-git-tag-version && npm run dist",
    "release:major": "npm version major --no-git-tag-version && npm run dist",
    "test": "node --test 'test/**/*.test.js'",
    "test:native": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test test/productImageFilename.test.js test/stockQty.test.js test/assetDirCollision.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "postinstall": "electron-builder install-app-deps",
    "native:host": "electron-builder install-app-deps --arch arm64",
    "install:sharp": "npm install --no-save --include=optional --force --cache node_modules/.cache/npm-sharp @img/sharp-darwin-arm64@0.33.5 @img/sharp-libvips-darwin-arm64@1.0.4",
    "check:render": "electron scripts/probe-render-paint.js"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.5.5",
    "better-sqlite3": "^11.5.0",
    "bwip-js": "^4.10.1",
    "sharp": "^0.33.5",
    "ws": "^8.20.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.terranash.mediastudiokh",
    "productName": "Business Studio KH",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/bindings/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/fonts",
        "to": "fonts"
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/main/index.js"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "darkModeSupport": true,
      "minimumSystemVersion": "11.0.0",
      "identity": null,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Business Studio KH ${version} (${arch})",
      "writeUpdateInfo": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis"
    }
  }
}
