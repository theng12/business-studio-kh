<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's JIT needs these two under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- Sparkle.framework is signed by the local KH Studio identity, which has no Team ID,
       so library validation must be off or dyld refuses the framework at launch
       (the Displays 0.1.8 lesson: that refusal is invisible to a deep codesign verify). -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- Server / client mode, and files the person picks. -->
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.network.server</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
  <key>com.apple.security.files.downloads.read-write</key><true/>
</dict>
</plist>
